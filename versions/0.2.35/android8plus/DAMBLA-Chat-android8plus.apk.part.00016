        const exists = context.exists(url)

        if (isThenable(exists)) return bundle.exists(url.href)

        return exists || bundle.exists(url.href)
      },

      existsSync(context, url) {
        if (bundleOwns(bundle, url)) return true

        const exists = context.existsSync(url)

        if (isThenable(exists)) return bundle.exists(url.href)

        return exists || bundle.exists(url.href)
      },

      read(context, url) {
        if (bundleOwns(bundle, url)) return bundle.read(url.href)

        const source = context.read(url)

        if (isThenable(source)) return bundle.read(url.href)

        return source || bundle.read(url.href)
